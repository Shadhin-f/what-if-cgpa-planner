{
  "manifest_version": 3,
  "name": "What if CGPA Planner",
  "version": "1.0.0",
  "description": "Edit, analyze, and plan your semesters directly on the NSU RDS grade history page.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://rds3.northsouth.edu/students/grade_history*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
