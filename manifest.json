{
  "manifest_version": 3,
  "name": "What if CGPA Planner",
  "version": "1.2.5",
  "description": "Edit, analyze, and plan your semesters, plus a quick-glance widget for today's routine and attendance on the NSU RDS portal.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://rds3.northsouth.edu/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://rds3.northsouth.edu/*"],
      "js": ["mini-rds3.js"],
      "css": ["mini-rds3.css"],
      "run_at": "document_idle"
    }
  ]
}
