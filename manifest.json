{
  "manifest_version": 3,
  "name": "What if CGPA Planner",
  "version": "2.5.0",
  "description": "Edit, analyze, and plan your semesters, plus a quick-glance widget for today's routine and attendance on the NSU RDS portal.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "What if CGPA Planner"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rds3.northsouth.edu/students/landing*",
        "https://rds3.northsouth.edu/students/grade_history*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rds3.northsouth.edu/students/landing*",
        "https://rds3.northsouth.edu/students/grade_history*"
      ],
      "js": ["mini-rds3.js"],
      "css": ["mini-rds3.css"],
      "run_at": "document_idle"
    }
  ]
}
